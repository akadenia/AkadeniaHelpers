{
  "name": "@akadenia/helpers",
  "version": "1.11.3",
  "description": "Akadenia helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "helpers",
    "akadenia"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "test": "jest",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,yml}\"",
    "lint": "prettier --check \"./**/*.{ts,tsx,js,jsx,json,yml}\"",
    "prepare": "pnpm run build",
    "version": "git add -A src",
    "updateLink": "pnpm run build && pnpm rm -g @akadenia/helpers && pnpm add -g .",
    "generate:docs": "jsdoc2md dist/*.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akadenia/AkadeniaHelpers.git"
  },
  "author": "Akadenia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akadenia/AkadeniaHelpers/issues"
  },
  "homepage": "https://akadenia.com/packages/akadenia-helpers",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@jest/globals": "^30.5.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jsdoc-to-markdown": "^9.1.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "25.0.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.x"
  },
  "packageManager": "pnpm@11.9.0"
}
